# /opt/bmu-lab/.env on the VPS — production values. NEVER commit the real file.
# Generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"                       (JWT_SECRET, passwords)
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  (APP_ENCRYPTION_KEY)
# The API refuses to start in prod with development secrets (app/config.py: check_production).

# --- images & routing ---
REGISTRY=ghcr.io/your-github-user-or-org
SITE_ADDRESS=lab.example.org
ACME_EMAIL=it@example.org
API_WORKERS=4

ENV=prod
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://lab.example.org
STAFF_BASE_URL=https://lab.example.org/staff
API_BASE_URL=https://lab.example.org
CORS_ORIGINS=["https://lab.example.org"]
COOKIE_SECURE=true

# --- secrets ---
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
APP_ENCRYPTION_KEY=change-me
S3_ACCESS_KEY=bmu-objects
S3_SECRET_KEY=change-me
S3_PUBLIC_ENDPOINT=http://minio:9000

# --- integrations [BMU] (mock until the institution provides accounts) ---
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=BMU LAB
PAYMENT_PROVIDER=mock

# --- operations (defaults are in .env.example; override here as needed) ---
VERIFICATION_SLA_HOURS=4
SLIP_ACCOUNT_HEAD=PLACEHOLDER — account head to be confirmed by BMU
