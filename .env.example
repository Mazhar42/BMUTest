# BMU Lab — every configuration key. Copy to .env (never commit .env).
# Values below are safe DEV defaults; production must override every secret.

ENV=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:5173
STAFF_BASE_URL=http://localhost:5174/staff
API_BASE_URL=http://localhost:18000
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:8090"]

# --- data stores (compose overrides hostnames inside containers) ---
POSTGRES_PASSWORD=bmu
DATABASE_URL=postgresql+psycopg://bmu:bmu@localhost:55432/bmu
TEST_DATABASE_URL=postgresql+psycopg://bmu:bmu@localhost:55432/bmu_test
REDIS_URL=redis://localhost:56379/0
CELERY_ENABLED=false

# --- secrets (generate new ones for production) ---
JWT_SECRET=dev-only-change-me-dev-only-change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=2BnaXi43ui3u9V6P6smjhJdmEbs8ugB5oUW6aM0oXA8=

# --- staff auth ---
STAFF_SESSION_HOURS=12
STAFF_IDLE_LOCK_MINUTES=30
STAFF_MAX_FAILED_LOGINS=5
STAFF_LOCKOUT_MINUTES=15
# --- patient auth ---
PATIENT_ACCESS_TOKEN_MINUTES=15
PATIENT_REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_SEND_LIMIT_PER_MOBILE=3
OTP_SEND_WINDOW_MINUTES=15
OTP_SEND_LIMIT_PER_IP=20

# --- object storage (MinIO) ---
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=./storage
# host ports of the object store (change if Windows reserves 59000: netsh int ipv4 show excludedportrange tcp)
S3_HOST_PORT=59000
S3_CONSOLE_HOST_PORT=59001
S3_ENDPOINT=http://localhost:59000
S3_PUBLIC_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY=bmuminio
S3_SECRET_KEY=bmuminio-secret
S3_REGION=us-east-1
PRESIGN_SECONDS=300

# --- SMS [BMU: choose a BTRC-registered provider] ---
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=BMU LAB

# --- payments [BMU: merchant account in BMU's name] ---
PAYMENT_PROVIDER=mock
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true
PAYMENT_PENDING_REQUERY_MINUTES=10
PAYMENT_PENDING_EXPIRE_HOURS=24
PAYMENT_CURRENCY=BDT
COUNTER_PAYMENT_ENABLED=false
TELLER_REQUIRE_RECEIPT_NO=false

# --- orders / codes / specimens ---
VERIFICATION_SLA_HOURS=4
ORDER_EXPIRY_DAYS=7
TUBE_GROUPING=container
REQUIRE_PAPER_HOSPITAL_COPY=false
PRINT_BANK_COPY_WHEN_PAID=false
# [BMU] account head printed on the bank copy of the slip
SLIP_ACCOUNT_HEAD=PLACEHOLDER — account head to be confirmed by BMU

# --- scheduling & queue ---
SLOT_HOLD_MINUTES=15
SLOT_HORIZON_DAYS=14
FASTING_LAST_WINDOW_END=11:00
RESCHEDULE_MAX=2
RESCHEDULE_CUTOFF_HOURS=2
ALLOW_UNPAID_BOOKING_PCT=0
CHECKIN_EARLY_MINUTES=30
CHECKIN_LATE_MINUTES=30
REMINDER_HOUR_LOCAL=18
QUEUE_RATIO_A=2
QUEUE_RATIO_W=1

# --- results / reports ---
RELEASE_BY_ENTERER_ALLOWED=false
SHARE_LINK_DAYS=7
INSTITUTION_NAME_EN=Bangabandhu Sheikh Mujib Medical University
INSTITUTION_NAME_BN=বঙ্গবন্ধু শেখ মুজিব মেডিকেল বিশ্ববিদ্যালয়
LAB_NAME_EN=Department of Laboratory Medicine
LAB_NAME_BN=ল্যাবরেটরি মেডিসিন বিভাগ
INSTITUTION_ADDRESS=Shahbag, Dhaka-1000

# --- M10 / post-pilot (all off by default) ---
OCR_PROVIDER=none
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:lab@example.org
PADES_ENABLED=false
PADES_P12_PATH=
PADES_P12_PASSWORD=
HOME_COLLECTION_ENABLED=false
HOME_COLLECTION_FEE_PAISA=0
ANALYZER_TOKEN=
FHIR_PROFILE_BASE=https://fhir.dghs.gov.bd/core/StructureDefinition
SHR_ENDPOINT=
